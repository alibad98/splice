# Copy to .env for local development. Local, synthetic values only.
# API (apps/api)
DATABASE_URL=postgres://slips:slips@localhost:5432/slips
PORT=3001
CORS_ORIGINS=http://localhost:3000
# Worker queue groups: any subset of realtime,media,batch
WORKER_QUEUES=realtime,media,batch
# Object storage (MinIO, local only; used from later stories)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=slips
S3_SECRET_KEY=slips-local-only
# Dashboard (apps/dashboard)
API_URL=http://localhost:3001
# Observability (apps/api)
LOG_LEVEL=info
# Comma-separated <flag>=true|false overrides; unset flags use their safe default
FEATURE_FLAGS=
# Bearer token (16+ chars) for GET /metrics; the endpoint is disabled when unset
METRICS_TOKEN=
# Worker liveness and metrics port (role=worker)
WORKER_HEALTH_PORT=3002
# Token custody (apps/api). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Never commit a real value, never log it.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=k1
# Salla OAuth app (Partners Portal). Required in production.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=http://localhost:3001/v1/integrations/salla/callback
# SALLA_SCOPES defaults to the adapter's minimal scope list
SALLA_SCOPES=
SALLA_APP_ID=
SALLA_WEBHOOK_SECRET=
# Where the merchant lands after install
DASHBOARD_URL=http://localhost:3000
