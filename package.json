{
  "name": "slips",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm -r --filter \"./packages/*\" --filter \"!@slips/player\" build && pnpm --parallel --filter \"./apps/*\" dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:turbo": "turbo run dev --ui=stream",
    "db:migrate": "pnpm --filter @slips/db build && node --env-file-if-exists=.env packages/db/scripts/migrate.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
