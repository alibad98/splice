{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/player-preview/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "TEST_DATABASE_PORT",
        "TEST_ADMIN_URL",
        "TEST_APP_URL",
        "CONTENT_TEST_ADMIN_URL",
        "PREVIEW_TEST_DATABASE_URL",
        "FFMPEG_PATH"
      ]
    }
  }
}
