{
  "version": 1,
  "description": "Vendor-neutral alert rules over the metrics served at /metrics. Expressions use PromQL syntax so any compatible backend can load them. Thresholds are the configured values; change them here.",
  "rules": [
    {
      "id": "api-error-rate-5m",
      "summary": "API 5xx rate above threshold over 5 minutes",
      "expr": "sum(rate(slips_api_requests_total{outcome=\"server_error\"}[5m])) / sum(rate(slips_api_requests_total[5m])) > 0.05",
      "threshold": 0.05,
      "window": "5m",
      "for": "5m",
      "severity": "page",
      "owner": "platform-oncall",
      "runbook": "docs/runbooks/alert-api-error-rate.md"
    },
    {
      "id": "webhook-dead-lettered",
      "summary": "A webhook job exhausted its retries and was dead-lettered",
      "expr": "max(slips_dead_letter_depth{queue=~\"integration\\\\.webhook.*\"}) > 0",
      "threshold": 0,
      "window": "1m",
      "for": "0m",
      "severity": "page",
      "owner": "integration-owner",
      "runbook": "docs/runbooks/alert-webhook-dead-letter.md"
    },
    {
      "id": "catalog-reconcile-dead-lettered",
      "summary": "A daily catalog reconcile job (a store's reconcile or the daily fan-out) exhausted its retries and was dead-lettered",
      "expr": "max(slips_dead_letter_depth{queue=~\"catalog\\\\.reconcile.*\"}) > 0",
      "threshold": 0,
      "window": "1m",
      "for": "0m",
      "severity": "ticket",
      "owner": "catalog-owner",
      "runbook": "docs/runbooks/alert-catalog-reconcile-dead-letter.md"
    }
  ]
}
