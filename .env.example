# Copy to .env for local development. Local, synthetic values only.
# API (apps/api)
DATABASE_URL=postgres://slips:slips@localhost:5432/slips
PORT=3001
CORS_ORIGINS=http://localhost:3000
# Worker queue groups: any subset of realtime,media,batch
WORKER_QUEUES=realtime,media,batch
# Object storage (MinIO, local only; used from later stories)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=slips
S3_SECRET_KEY=slips-local-only
# Dashboard (apps/dashboard)
API_URL=http://localhost:3001
# Observability (apps/api)
LOG_LEVEL=info
# Comma-separated <flag>=true|false overrides; unset flags use their safe default
FEATURE_FLAGS=
# Bearer token (16+ chars) for GET /metrics; the endpoint is disabled when unset
METRICS_TOKEN=
# Worker liveness and metrics port (role=worker)
WORKER_HEALTH_PORT=3002
# Token custody (apps/api). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Never commit a real value, never log it.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=k1
# HMAC secret (32+ chars) for the OAuth state; same on every replica and across restarts. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OAUTH_STATE_SECRET=
# Salla OAuth app (Partners Portal). Required in production.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=http://localhost:3001/v1/integrations/salla/callback
# SALLA_SCOPES defaults to the adapter's minimal scope list
SALLA_SCOPES=
SALLA_APP_ID=
SALLA_WEBHOOK_SECRET=
# Where the merchant lands after install
DASHBOARD_URL=http://localhost:3000
# Port for the dashboard dev server (default 3000); keep DASHBOARD_URL and CORS_ORIGINS in step with it
DASHBOARD_PORT=3000

# Story 1.9: sessions and framing
# Browser-reachable API URL for the dashboard (defaults to API_URL)
# PUBLIC_API_URL=http://localhost:3001
# Origin allowed to frame merchant pages (default https://s.salla.sa); /admin is never framable
# EMBED_ALLOWED_ORIGIN=https://s.salla.sa
# Domain attribute for the merchant session cookie when API and dashboard are on sibling hosts (e.g. slips.app)
# SESSION_COOKIE_DOMAIN=

# Story 1.13 (G6), DEV ONLY, never in production (env validation refuses it): write each verified Salla webhook,
# PII-scrubbed, as a json fixture into this directory. Off when unset.
# WEBHOOK_RECORD_DIR=/tmp/salla-recorded
